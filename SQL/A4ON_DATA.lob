 Var
  f: TForm;
  pnlTop: TPanel;
  pnlGrid: TPanel;
  pnlHead: TPanel;
  pnlBottom: TPanel;
  mmoLog: TMemo;
  dlgOpen: TOpenDialog;
  btnOpen: TButton;
  btnClose: TButton;
  Grid   : TMemo;
  lbl1: TLabel;
  lblCount: TLabel;
  db: TIBDatabase;
  Query: TIBQuery;
  SelectQuery: TIBQuery;
  trRead: TIBTransaction;
  trWrite: TIBTransaction;
  srcSrc: TDataSource;
  ibqry: TIBQuery;
const
// Ëèöåâîé ñ÷åò;	Ôàìèëèÿ;	Èìÿ; Îò÷åñòâî; Óëèöà;	Äîì;	Êâàğòèğà;	Ñàëüäî;	Àòğèáóò;
   c_acc = 1;
   c_sur = 2;
   c_fir = 3;
   c_mid = 4;
   c_str = 5;
   c_hou = 6;
   c_flt = 7;
   c_sld = 8;
   c_atr = 9;

procedure btnOpenClick(Sender: TButton);
var
  s, c         : string;
  i,j          : Integer;
  VExcel       : Variant;
  Rows, Columns: Integer;
  customer_id  : Integer;
  pd_id        : Integer;
  house_id     : Integer;
  atr_id       : Integer;
begin
  if not dlgOpen.Execute then Exit;

  VExcel := CreateOLEObject('Excel.Application');
  with VExcel do
  begin
    Visible := False;
    //íå ïîêàçûâàòü ïğåäóïğåæäàşùèå ñîîáùåíèÿ
    VExcel.DisplayAlerts := False;
    //Îòêğûâàåì ğàáî÷óş êíèãó
    WorkBooks.Open(dlgOpen.FileName, 0, True);
    //Ñòàíîâèìñÿ íà ïåğâûé ëèñò
    WorkSheets[1].Activate;
    Rows := ActiveSheet.UsedRange.Rows.Count;
    Columns := ActiveSheet.UsedRange.Columns.Count;
    mmoLog.Lines.Clear;
    Grid.Lines.Clear;
    lbl1.Caption := 'Ôàéë ' + dlgOpen.FileName;
    if Rows>1
    then begin
      ibqry.SQL.Text := 'select gen_id(GEN_CUSTOMER_UID, '+IntToStr(Rows)+') as CID  from rdb$database';
      ibqry.Open;
      customer_id := ibqry.FieldByName('CID').AsInteger - Rows;
      ibqry.Close;
      for i := 2 to Rows do begin
        s := '';
        for j := 1 to Columns do begin
          c := Cells[i,j];
          s:=s + ' ' + c;
        end;
        Grid.Lines.Add(s);
        house_id := FindCustomerHouse(Cells[i,c_str],Cells[i,c_hou]);
        if house_id > 0
        then begin
          AddCustomer(customer_id, house_id, Cells[i,c_acc], Cells[i,c_flt], Cells[i,c_sur],Cells[i,c_fir],Cells[i,c_mid]);
          atr_id := FindAtributeID(Cells[i,c_atr]);
          if atr_id <0
          then begin
            AddAtributeID(Cells[i,c_atr]);
            atr_id := FindAtributeID(Cells[i,c_atr]);
          end;
          if atr_id > 0
          then AddCustomerAtribute(customer_id, atr_id)
          else begin
            c := Cells[i,c_acc];
            s := 'Íå äîáàâëåí àòğèáóò: ' + c;
            c := Cells[i,c_atr];
            mmoLog.Lines.Add(s+ ' '+c);
          end;
          customer_id := customer_id + 1;
        end
        else begin
            c := Cells[i,c_acc];
            s := 'Íå íàéäåí àäğåñ: ' + c;
            c := Cells[i,c_str];
            s := s + ' ' + c;
            c := Cells[i,c_flt];
            s := s + ' ' + c;
          mmoLog.Lines.Add(s);
        end;
      end;
    end;
  end;
  lblCount.Caption := 'Îáğàáîòàíî çàïèñåé : '+ IntToStr(Rows);
  VExcel.ActiveWorkbook.Close;
  VExcel.Application.Quit;
end;

function FindCustomerHouse(street : string; house : string) : Integer;
var
  s :string;
  street_id : Integer;
  pay  : Extended;
  Finded : Boolean;
begin
  Result := -1;
  SelectQuery.SQL.Text := 'select STREET_ID from STREET where UPPER(STREET_NAME) = UPPER(:STREET)';
  SelectQuery.Params.ParamByName('STREET').AsString      := street;
  //SelectQuery.Transaction.StartTransaction;
  SelectQuery.Open;
  Finded := not (SelectQuery.FieldByName('STREET_ID').isNull);
  if finded then street_id := SelectQuery.FieldByName('STREET_ID').AsInteger;
  SelectQuery.Transaction.Commit;

  if Finded
  then begin
    SelectQuery.SQL.Text := 'select HOUSE_ID from HOUSE where UPPER(house_no) = UPPER(:house_no) and STREET_ID = :STREET_ID';
    SelectQuery.Params.ParamByName('house_no').AsString  := house;
    SelectQuery.Params.ParamByName('STREET_ID').AsInteger := street_id;
    //SelectQuery.Transaction.StartTransaction;
    SelectQuery.Open;
    Finded := not (SelectQuery.FieldByName('HOUSE_ID').isNull);
    if finded then Result := SelectQuery.FieldByName('HOUSE_ID').AsInteger;
    SelectQuery.Transaction.Commit;
  end
end;

function FindAtributeID(atr : String) : Integer;
var
  s :string;
  street_id : Integer;
  pay  : Extended;
  Finded : Boolean;
begin
  Result := -1;
  SelectQuery.SQL.Text := 'select o.o_id  from objects o where o.o_type = 4 and UPPER(o.o_name) = upper(:ATRIBUTE)';
  SelectQuery.Params.ParamByName('ATRIBUTE').AsString      := atr;
  //SelectQuery.Transaction.StartTransaction;
  SelectQuery.Open;
  Finded := not (SelectQuery.FieldByName('o_id').isNull);
  if finded then Result := SelectQuery.FieldByName('o_id').AsInteger;
  SelectQuery.Transaction.Commit;
end;

procedure AddAtributeID(atr : String);
begin
  ibqry.SQL.Text := 'insert into objects (o_type, o_name) values (4, :o_name)';
  ibqry.Params.ParamByName('o_name').AsString   := atr;
  ibqry.ExecSQL;
  ibqry.Transaction.Commit;
end;

procedure CloseClick(Sender : TButton);
begin
  f.ModalResult := mrOk;
end;

procedure AddCustomerAtribute(Idx : Integer; atr_id : Integer);
begin
  ibqry.SQL.Text := 'insert into CUSTOMER_ATTRIBUTES (CUSTOMER_ID, O_ID, CA_VALUE) values (:CUSTOMER_ID, :O_ID, :CA_VALUE)';
  ibqry.Params.ParamByName('CUSTOMER_ID').AsInteger := Idx;
  ibqry.Params.ParamByName('O_ID').AsInteger    := atr_id;
  ibqry.Params.ParamByName('CA_VALUE').AsString   := '';
  ibqry.ExecSQL;
  ibqry.Transaction.Commit;
end;

procedure AddCustomer(Idx : Integer; house_id : Integer; account : string; flat : string; SURNAME : string; FIRSTNAME : string; MIDLENAME : string;);
begin
  ibqry.SQL.Text := 'insert into CUSTOMER (CUSTOMER_ID, HOUSE_ID, ACCOUNT_NO, SURNAME, FIRSTNAME, MIDLENAME, FLAT_NO)'+
                    ' values (:CUSTOMER_ID, :HOUSE_ID, :ACCOUNT_NO, :SURNAME, :FIRSTNAME, :MIDLENAME, :FLAT_NO)';
  ibqry.Params.ParamByName('CUSTOMER_ID').AsInteger := Idx;
  ibqry.Params.ParamByName('HOUSE_ID').AsInteger    := house_id;
  ibqry.Params.ParamByName('ACCOUNT_NO').AsString   := account;
  ibqry.Params.ParamByName('SURNAME').AsString      := SURNAME;
  ibqry.Params.ParamByName('FIRSTNAME').AsString    := FIRSTNAME;
  ibqry.Params.ParamByName('MIDLENAME').AsString    := MIDLENAME;
  ibqry.Params.ParamByName('FLAT_NO').AsString      := flat;
  ibqry.ExecSQL;
  ibqry.Transaction.Commit;
end;

begin
