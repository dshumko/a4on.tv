procedure ExportClick(Sender: TButton);
var
 s : String;
begin
  SaveDialog.FileName := 'abon8609_srv00793.'+FormatDateTime('m.yyyy', now())+'.txt';
  if SaveDialog.Execute then begin
  qryCustomers.First;
  qryCustomers.DisableControls;
  List.Clear;
  // "Íîìåğ ëèöåâîãî ñ÷¸òà;Ïîëíûé àäğåñ;Ñóììà;"
  while not qryCustomers.EOF do begin
    s:= qryCustomers.FieldByName('ACCOUNT_NO').AsString+';';
    s:= s+qryCustomers.FieldByName('Surname').AsString+' '+qryCustomers.FieldByName('Initials').AsString+';';
    s:= s+'Ñìîëåíñê, '
         +qryCustomers.FieldByName('street_short').AsString+' '
         +qryCustomers.FieldByName('Street_Name').AsString+', '
         +qryCustomers.FieldByName('House_No').AsString+', '
         +qryCustomers.FieldByName('FLAT_NO').AsString+';';
    s:= s+FloatToStr(-1*qryCustomers.FieldByName('Debt_SUM').AsFloat)+'.00;;;;';
    List.Add(s);
    qryCustomers.Next;
  end;

  List.SaveToFile(SaveDialog.FileName);
  qryCustomers.EnableControls;
  end;
end;

