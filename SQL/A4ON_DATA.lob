function ReplaceDot(s : string):string;
var
  i : Integer;
begin
  i := pos('.',s);
  if i>0
  then Result := copy(s,1,i-1)+','+copy(s,i+1,255)
  else Result := s;
end;

function TrimZerro(s : string):string;
var
  i : Integer;
begin
  while (copy(s, 1, 1) = '0') do
    s := copy(s, 2, 255);

  while (copy(s, length(s), 1) = ' ') do
    s := copy(s, 1, length(s)-1);

  Result := s;
end;

function Str2Date(Str : string):TDateTime;
var
  i,y,m,d,e : Integer;
  s : string;
begin
  i := pos('-',Str)-1;
  s := copy(Str, 1, i);
  Y := StrToInt(s);
  str := copy(Str, i+2, 255);
  i := pos('-',Str)-1;
  s := copy(Str, 1, i);
  m := StrToInt(s);
  str := copy(Str, i+2, 255);
  d := StrToInt(str);
  Result := EncodeDate(y,m,d);
end;

function FindMatDoc(DOC_NUMBER : String): Integer;
begin
    Result := -1;
    IBQuery1.SQL.Text := 'select Doc_Id from Material_Docs md where md.Dt_Id = 1 and md.Doc_N = :DOC_NUMBER';
    IBQuery1.Params.ParamByName('DOC_NUMBER').AsString  := copy(DOC_NUMBER, 0, 50);
    IBQuery1.Open;
    if not IBQuery1.FieldByName('Doc_Id').isNull
    then Result := IBQuery1.FieldByName('Doc_Id').AsInteger;
    IBQuery1.Close;
end;


function FindShipper(UNP : String): Integer;
begin
    Result := -1;
    IBQuery1.SQL.Text := 'SELECT O_ID FROM OBJECTS where O_TYPE = 29 and O_DEMENSION = :UNP';
    IBQuery1.Params.ParamByName('UNP').AsString  := copy(UNP, 0, 50);
    IBQuery1.Open;
    if not IBQuery1.FieldByName('O_ID').isNull
    then Result := IBQuery1.FieldByName('O_ID').AsInteger;
    IBQuery1.Close;
end;

function FindMaterial(M_Number : String): Integer;
begin
    Result := -1;
    IBQuery1.SQL.Text := 'select M_Id from Materials m where M_Number = :M_Number';
    IBQuery1.Params.ParamByName('M_Number').AsString  := copy(M_Number, 0, 50);
    IBQuery1.Open;
    if not IBQuery1.FieldByName('M_Id').isNull
    then Result := IBQuery1.FieldByName('M_Id').AsInteger;
    IBQuery1.Close;
end;

function AddShipper(UNP : String): Integer;
begin
    IBQuery1.SQL.Text := 'select gen_id(gen_operations_uid, 1) as CID  from rdb$database';
    IBQuery1.Open;
    Result := IBQuery1.FieldByName('CID').AsInteger;
    IBQuery1.Close;
    IBQuery1.SQL.Text := 'INSERT INTO OBJECTS (O_ID, O_TYPE, O_NAME, O_DEMENSION) VALUES (:ID, 29, :UNP, :UNP);';
    IBQuery1.Params.ParamByName('ID').AsInteger := Result;
    IBQuery1.Params.ParamByName('UNP').AsString  := copy(UNP, 0, 50);
    IBQuery1.ExecSQL;
    IBQuery1.Transaction.Commit;
end;

function AddDoc(DOC: string; DDate : string; shipper : integer): Integer;
begin
    IBQuery1.SQL.Text := 'select gen_id(gen_operations_uid, 1) as CID  from rdb$database';
    IBQuery1.Open;
    Result := IBQuery1.FieldByName('CID').AsInteger;
    IBQuery1.Close;

    IBQuery1.SQL.Text := 'insert into Material_Docs (Doc_Id, Doc_N, Doc_Date, Dt_Id, Wh_Id, Doc_Closed, Shipper) values (:ID, :Doc_N, :Doc_Date, 1, :WH_ID, 0, :Shipper)';
    IBQuery1.Params.ParamByName('ID').AsInteger := Result;
    IBQuery1.Params.ParamByName('Doc_N').AsString  := copy(DOC, 0, 50);
    IBQuery1.Params.ParamByName('Doc_Date').AsDate  := Str2Date(DDate);
    IBQuery1.Params.ParamByName('WH_ID').AsInteger := 1530;
    IBQuery1.Params.ParamByName('Shipper').AsInteger := Shipper;
    IBQuery1.ExecSQL;
    IBQuery1.Transaction.Commit;
end;

function AddMaterial(Name: string; Demension : string; M_Number : string): Integer;
begin
    IBQuery1.SQL.Text := 'select gen_id(gen_operations_uid, 1) as CID  from rdb$database';
    IBQuery1.Open;
    Result := IBQuery1.FieldByName('CID').AsInteger;
    IBQuery1.Close;
    IBQuery1.SQL.Text := 'insert into Materials (M_Id, Name, Demension, Deleted, M_Number) values (:ID, :Name, :Demension, 0, :M_Number)';
    IBQuery1.Params.ParamByName('ID').AsInteger := Result;
    IBQuery1.Params.ParamByName('Name').AsString := copy(Name, 0, 100);
    IBQuery1.Params.ParamByName('Demension').AsString := copy(Demension, 0, 10);
    IBQuery1.Params.ParamByName('M_Number').AsString := copy(M_Number, 0, 20);
    IBQuery1.ExecSQL;
    IBQuery1.Transaction.Commit;
end;

procedure AddMatInDoc(Doc_Id : integer; M_Id : integer; M_Quant : string; Shipper_Cost : string);
begin
    IBQuery1.SQL.Text := 'insert into Materials_In_Doc (Doc_Id, M_Id, M_Quant, M_Cost, Shipper_Cost) values (:Doc_Id, :M_Id, :M_Quant, 0, :Cost)';
    IBQuery1.Params.ParamByName('Doc_Id').AsInteger := Doc_Id;
    IBQuery1.Params.ParamByName('M_Id').AsInteger   := M_Id;
    IBQuery1.Params.ParamByName('M_Quant').AsFloat  := StrToFloat(ReplaceDot(M_Quant));
    IBQuery1.Params.ParamByName('Cost').AsFloat     := StrToFloat(ReplaceDot(Shipper_Cost));
    IBQuery1.ExecSQL;
    IBQuery1.Transaction.Commit;
end;

procedure CloseDoc(Doc_Id : integer);
begin
    IBQuery1.SQL.Text := 'execute procedure Close_Material_Doc(:Doc_Id)';
    IBQuery1.Params.ParamByName('Doc_Id').AsInteger := Doc_Id;
    IBQuery1.ExecSQL;
    IBQuery1.Transaction.Commit;
end;


procedure ButtonClick(Sender: TButton);
var
    s,a, m: string;
    c  : double;
    od : TOpenDialog;
    pi : TListItem;
    XML: TfsXMLDocument;
    xI : TfsXMLItem;
    xD : TfsXMLItem;
    i,d  : Integer;
    shipper : Integer;
    unp : String;
    Doc : Integer;
    mi : Integer;
begin
    if not OpenDialog.Execute then exit;

    log.Lines.Clear;

    XML := TfsXMLDocument.Create();
    FromWinToUtf8(OpenDialog.FileName);
    XML.LoadFromFile(OpenDialog.FileName);
    for d := 0 to XML.Root.Count-1 do begin
        xD := XML.Root.Items(d);
        s := TrimZerro(xD.Prop('ÍîìåğÄîê'));
        unp := TrimZerro(xD.Prop('ÓÍÍ'));

        if (xD.Count = 0)
        then begin
            log.Lines.Add('Äîêóìåíò '+s+' ïóñòîé. Ïğîïóñòèì.');
            continue;
        end;

        doc := FindMatDoc(s);

        if (doc > 0)
        then begin
            log.Lines.Add('Äîêóìåíò '+s+' óæå çàãğóæåí');
            continue;
        end;
        log.Lines.Add('Äîêóìåíò '+s);
        shipper := FindShipper(unp);
        if shipper = -1 then shipper := AddShipper(unp);
        doc := AddDoc(s, xD.Prop('Äàòà'), shipper );
        for i := 0 to xD.Count-1 do begin
            xI := xD.Items(i);
            a := TrimZerro(xI.Prop('Êîä'));
            mi := FindMaterial(a);
            m := xI.Prop('Ìàòåğèàë');
            log.Lines.Add(m + ' = '+xI.Prop('Êîëè÷åñòâî')+' ' +xI.Prop('Åäèíèöà'));
            if mi = -1 then mi := AddMaterial(m, xI.Prop('Åäèíèöà'), a);

            AddMatInDoc(doc, mi, xI.Prop('Êîëè÷åñòâî'), xI.Prop('Öåíà'));
        end;
        CloseDoc(doc);
    end;
    XML.Free;
    RenameFile(OpenDialog.FileName, OpenDialog.FileName+'.txt');
end;

