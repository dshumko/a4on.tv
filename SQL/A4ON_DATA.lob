    Params.Add('lc_ctype=UTF8');
    Connected := True;
  end;
  with IBTransaction1 do
  begin
    Name := 'IBTransaction1';
    DefaultDatabase := IBDatabase1;
  end;
  with SaveDialog do begin
    Name:= 'SaveDialog';
    FileName := 'export.txt';
    Filter := '*.TXT|*.TXT';
  end;
  qryCustomers.Active := true;

  f.ShowModal;
  f.Free;
end.
