    end;
    with chAtr do begin
      Left := 100;
      Top := 155;
      Width := 255;
      Height := 25;
      Caption := 'Ïåğåíåñòè àòğèáóòû';
      TabOrder := 5;
      Checked := true;
      parent := f;
    end;
    with btnChange do begin
      Left := 100;
      Top := 195;
      Width := 255;
