procedure CreateClick(Sender: TButton);
var
  s,sh : string;
  itog : double;
  bm : TBookmark;
begin
  mmo.Lines.Clear;
  try
    CustomersForm.dsCustomers.Disablecontrols;
    bm := CustomersForm.dsCustomers.GetBookMark;
    CustomersForm.dsCustomers.First;
    while not CustomersForm.dsCustomers.Eof do begin
     s := CustomersForm.dsCustomers.FieldByName('ACCOUNT_NO').AsString;
     s := s + ' ' + CustomersForm.dsCustomers.FieldByName('SURNAME').AsString;
     s := s + ' ' + CustomersForm.dsCustomers.FieldByName('FIRSTNAME').AsString;
     s := s + ' ' + CustomersForm.dsCustomers.FieldByName('INITIALS').AsString;
     s := s + ' ' + CustomersForm.dsCustomers.FieldByName('DEBT_SUM').AsString;
     s := s + ' ' + CustomersForm.dsCustomers.FieldByName('STREET_SHORT').AsString;
     s := s + ' ' + CustomersForm.dsCustomers.FieldByName('STREET_NAME').AsString;
     s := s + ' a ' + CustomersForm.dsCustomers.FieldByName('HOUSE_NO').AsString;
     s := s + ' e ' + CustomersForm.dsCustomers.FieldByName('FLAT_NO').AsString;
     mmo.Lines.Add(s);
     CustomersForm.dsCustomers.Next;
    end;
    CustomersForm.dsCustomers.GotoBookMark(bm);
    CustomersForm.dsCustomers.EnableControls;
    btnSave.Enabled := true;
  except
    ShowMessage('Îòêğîéòå ñïèñîê àáîíåíòîâ (ÀÁÎÍÅÍÒÛ)!');
  end;
end;

procedure SaveClick(Sender: TButton);
var
  s : string;
  i : integer;
begin
  if SaveDialog.Execute
  then mmo.Lines.SaveToFile(SaveDialog.FileName);
end;

