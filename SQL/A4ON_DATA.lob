var
  f         : TForm;
  db        : TIBDatabase;
  qPrepay   : TIBQuery;
  trRead   : TIBTransaction;
  lbl1      : TLabel;
  lbl2      : TLabel;
  btnChange : TButton;
  edPrepay  : TEdit;
  edAcc  : TEdit;


procedure ChangeClick(Sender: TButton);
var
 n : string;
begin
  n := '''' + edAcc.Text + '''';
  edPrepay.Text := '';

  qPrepay.Sql.Text := 'select Prepay from Get_Recommended_Prepay('+
                      '(select first 1 c.Customer_Id from customer c where c.Account_No = '+ n +'), null)';
  qPrepay.Active := True;
  if (not qPrepay.FieldByName('Prepay').IsNull) then
    edPrepay.Text := qPrepay.FieldByName('Prepay').AsString;
  qPrepay.Active := False;
end;

begin
  f := TForm.Create(nil);
  f.Caption := 'Ğàññ÷åò ïğåäîïëàòû';
  f.BorderStyle := bsDialog;
  f.Position := poScreenCenter;
  f.Height := 154;
  f.Width  := 300;

  db        := TIBDatabase.Create(f);
  qPrepay   := TIBQuery.Create(f);
  trRead   := TIBTransaction.Create(f);
  lbl1      := TLabel.Create(f);
  lbl2      := TLabel.Create(f);
  edAcc  := TEdit.Create(f);
  edPrepay  := TEdit.Create(f);
  btnChange := TButton.Create(f);

  with trRead do
  begin
    Name := 'trRead';
    defaultDatabase := db;
  end;
  with db do
  begin
    Name := 'db';
    Params.Clear;
    LoginPrompt := False;
    DefaultTransaction := trRead;
    DatabaseName := A4ON_DB;
    Params.Add('user_name='+A4ON_USER);
    Params.Add('password='+A4ON_PASSWORD);
    Params.Add('sql_role_name=ROLE_A4USER');
    Params.Add('lc_ctype=UTF8');
    Connected := True;
  end;
  with qPrepay do
  begin
    Name := 'qPrepay';
    ParamCheck := False;
    Database := db;
    Transaction := trRead;
    SQL.Clear;
  end;
    with lbl1 do begin
      Left := 10;
      Top := 10;
      Width := 61;
      Height := 13;
      Caption := 'Ëèöåâîé';
      parent := f;
    end;
    with edAcc do begin
      Left   := 10;
      Top    := 25;
      Width  := 255;
      Height := 13;
      Text   := '';
      parent := f;
      TabOrder := 2;
      try
        Text := CustomersForm.dsCustomers.FieldByName('ACCOUNT_NO').AsString;
      except
        Text := '';
      end;
    end;
    with btnChange do begin
      Left := 10;
      Top := 50;
      Width := 255;
      Height := 25;
      Caption := 'Ğàññ÷òàòü ïğåäîïëàòó';
      TabOrder := 6;
      parent := f;
      OnClick := @ChangeClick;
    end;
    with lbl2 do begin
      Left := 10;
      Top := 82;
      Width := 61;
      Height := 13;
      Caption := 'Ïğåäîïëàòà';
      parent := f;
    end;
    with edPrepay do begin
      Left   := 10;
      Top    := 95;
      Width  := 255;
      Height := 13;
      Text   := '';
      parent := f;
      TabOrder := 1;
    end;

  f.ShowModal;
  f.Free;
end.

var
  f : TForm;
  b : TButton;
  btnEXPORT : TButton;
  Panel1: TPanel;
  DBGrid1: TDBGrid;
  DataSource1: TDataSource;
  qryCustomers: TIBQuery;
  IBDatabase1: TIBDatabase;
  IBTransaction1: TIBTransaction;
  qInsert: TIBQuery;
  trWrite: TIBTransaction;

procedure ButtonClick(Sender: TButton);
begin
  f.ModalResult := mrOk;
end;

procedure ExportClick(Sender: TButton);
var
 s : String;
begin
  qryCustomers.First;
  qryCustomers.DisableControls;
  while not qryCustomers.EOF do begin
    s:= BASE64_Encode(qryCustomers.FieldByName('PSWD').AsString);

    qInsert.SQL.Text := 'update Customer set Secret = :Secret where Customer_Id = :Customer_Id';
    qInsert.Params.ParamByName('Customer_Id').AsInteger  := qryCustomers.FieldByName('Customer_Id').AsInteger;
    qInsert.Params.ParamByName('Secret').AsString   := s;
    qInsert.ExecSQL;
    qInsert.Transaction.Commit;

    qryCustomers.Next;
  end;
  qryCustomers.First;
  qryCustomers.EnableControls;
end;

begin
  f := TForm.Create(nil);
  f.Caption := 'Ñîçäàòü ïàğîëè àáîíåíòàì';
  f.BorderStyle := bsSizeable;
  f.Position := poScreenCenter;
  f.Height := 480;
  f.Width  := 640;

  Panel1 := TPanel.Create(f);
  DBGrid1 := TDBGrid.Create(f);
  DataSource1 := TDataSource.Create(f);
  qryCustomers := TIBQuery.Create(f);
  IBDatabase1 := TIBDatabase.Create(f);
  IBTransaction1 := TIBTransaction.Create(f);
  b := TButton.Create(Panel1);
  btnEXPORT := TButton.Create(Panel1);

  qInsert := TIBQuery.Create(f);
  trWrite := TIBTransaction.Create(f);

  with Panel1 do
  begin
    Name := 'Panel1';
    Caption := 'Ñïèñîê âñåõ àáîíåíòîâ';
    Parent := f;
    Left := 0;
    Top := 0;
    Width := 562;
    Height := 41;
    Align := alTop;
    BevelOuter := bvNone;
    TabOrder := 0;
  end;
  with btnExport do
  begin
    Name := 'btnExport';
    Parent := Panel1;
    Left := 10;
    Top := 7;
    Width := 120;
    Height := 25;
    TabOrder := 0;
    Caption := 'Ñîõğàíèòü ïàğîëè';
    OnClick := @ExportClick;
    modalResult:= mrNone;
  end;
  with B do
  begin
    Name := 'Button1';
    Parent := Panel1;
    Left := 530;
    Top := 7;
    Width := 75;
    Height := 25;
    TabOrder := 3;
    Caption := 'Çàêğûòü';
    OnClick := @ButtonClick;
    Cancel := True;
  end;
  with DBGrid1 do
  begin
    Name := 'DBGrid1';
    Parent := f;
    Left := 0;
    Top := 41;
    Width := 562;
    Height := 260;
    Align := alClient;
    DataSource := DataSource1;
    TabOrder := 1;
  end;
  with DataSource1 do
  begin
    Name := 'DataSource1';
    DataSet := qryCustomers;
  end;
  with qryCustomers do
  begin
    Name := 'qryCustomers';
    Database := IBDatabase1;
    Transaction := IBTransaction1;
    SQL.Add('select C.Account_no, (select Pwd from Gen_Password(12, 12)) PSWD,  S.Street_Name||'' ''||s.street_short street, H.House_No, c.Flat_No, c.customer_id');
    SQL.Add('FROM CUSTOMER C INNER JOIN HOUSE H ON (C.HOUSE_ID = H.HOUSE_ID) INNER JOIN STREET S ON (H.STREET_ID = S.STREET_ID)');
    SQL.Add('order by C.account_no');
  end;
  with IBDatabase1 do
  begin
    Name := 'IBDatabase1';
    LoginPrompt := false;
    DefaultTransaction := IBTransaction1;
    DatabaseName := A4ON_DB;
    Params.Add('user_name='+A4ON_USER);
    Params.Add('password='+A4ON_PASSWORD);
    Params.Add('sql_role_name=ROLE_A4USER');
    Params.Add('lc_ctype=UTF8');
    Connected := True;
  end;
  with IBTransaction1 do
  begin
    Name := 'IBTransaction1';
    DefaultDatabase := IBDatabase1;
  end;
  with trWrite do
  begin
    Name := 'trWrite';
    DefaultDatabase := IBDatabase1;
    Params.Clear;
    Params.Add('read_committed');
    Params.Add('rec_version');
    Params.Add('nowait');
    Params.Add('write');
  end;
  with qInsert do begin
    Name := 'qInsert';
    Database := IBDatabase1;
    Transaction := trWrite;
    Active := False;
    BufferChunks := 1000;
    CachedUpdates := False;
    ParamCheck := True;
    SQL.Clear;
  end;

  qryCustomers.Active := true;

  f.ShowModal;
  f.Free;
end.
