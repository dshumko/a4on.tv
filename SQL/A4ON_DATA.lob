function AddMaterial(Name: string; Demension : string; M_Number : string): Integer;
begin
    IBQuery1.SQL.Text := 'select gen_id(gen_operations_uid, 1) as CID  from rdb$database';
    IBQuery1.Open;
    Result := IBQuery1.FieldByName('CID').AsInteger;
    IBQuery1.Close;

end;

procedure ButtonClick(Sender: TButton);
var
  vAction : Integer;
  dc : String;
begin
    if not ValidInt(edtClass.Text)
    then begin
      edtClass.Text := 'Óêàæèòå êëàññ';
      edtClass.SetFocus;
      exit;
    end;
    vAction := 2;

    if rbOn.Checked
    then begin
      vAction := 1;
      dc := '999';
    end
    else dc := 'null';

    IBQuery1.SQL.Text := 'insert into TQueue ("ACTION", HARDWARE_ID, DATETIME, CLASS_ID, DAYCOUNT)' + #13#10 +
                         'select :pAct, d.Decoder_N, current_timestamp, cast(s.External_Id as integer) as CLASS_ID, '+ dc + #13#10 +
                         'from Subscr_Hist sh inner join services s on (sh.Serv_Id = s.Service_Id)' + #13#10 +
                         '  inner join Customer_Decoders d on (sh.Customer_Id = d.Customer_Id)' + #13#10 +
                         'where s.External_Id = :pClass and current_date between sh.Date_From and sh.Date_To';

    IBQuery1.Params.ParamByName('pAct').AsInteger := vAction;
    IBQuery1.Params.ParamByName('pClass').AsString := edtClass.Text;
    IBQuery1.ExecSQL;
    IBQuery1.Transaction.Commit;
    f.close;
end;

