procedure btnOpenClick(Sender: TButton);
var
  i  : Integer;
  VExcel       : Variant;
  Rows, Columns: Integer;
begin
  if not dlgOpen.Execute then Exit;

  VExcel := CreateOLEObject('Excel.Application');
  with VExcel do begin
    Visible := False;
    VExcel.DisplayAlerts := False;
    WorkBooks.Open(dlgOpen.FileName, 0, True);
    WorkSheets[1].Activate;
    Rows := ActiveSheet.UsedRange.Rows.Count;
    Columns := ActiveSheet.UsedRange.Columns.Count;
    mmoLog.Lines.Clear;
    mmoAccounts.Lines.Clear;
    if Rows>1
    then begin
      for i := 1 to Rows do
        mmoAccounts.Lines.Add(Cells[i,1]);
    end;
  end;
  mmoAccounts.Lines.Add(cbCS.KeyValue);

  VExcel.ActiveWorkbook.Close;
  VExcel.Application.Quit;
end;

procedure btnConnectClick(Sender: TButton);
var
  i  : Integer;
  Rows, Columns: Integer;
  Account : string;
begin
  mmoLog.Lines.Clear;
  if mmoAccounts.Lines.Count = 0
  then mmoLog.Lines.Add('Ïóñòîé ñïèñîê ëèöåâûõ');

  if cbCS.Text = ''
  then mmoLog.Lines.Add('Íå óêàçàíî êàêîé óñëóãîé ïîäêëş÷åòü');

  if cbServices.Text = ''
  then mmoLog.Lines.Add('Êàêóş óñëóãó ïîäêëş÷àòü?');

  if mmoLog.Lines.Count <> 0
  then Exit;

  for i := 0 to mmoAccounts.Lines.Count-1 do begin
    Account := mmoAccounts.Lines[i];
    FindCustomer(Account);
  end;
  mmoLog.Lines.Add('Ïîäêëş÷åíèå çàâåğøåíî!');
end;

function FindCustomer(Account : string) : Boolean;
var
  s :string;
  Customer_Id : Integer;
  pay  : Extended;
  Finded : Boolean;
begin
  Result := False;
  SelectQuery.SQL.Text := 'select Customer_Id from customer where UPPER(Account_No) = UPPER(:ACC)';
  SelectQuery.Params.ParamByName('ACC').AsString := Account;
  SelectQuery.Open;
  Finded := not (SelectQuery.FieldByName('Customer_Id').isNull);
  if finded then Customer_Id := SelectQuery.FieldByName('Customer_Id').AsInteger;
  SelectQuery.Transaction.Commit;

  if Finded
  then begin
    Result := AddService(Customer_Id);
    if not Result
    then mmoLog.Lines.Add(Account+#9+'Îøèáêà äîáàâëåíèÿ óñëóãè');
  end
  else
    mmoLog.Lines.Add(Account+#9+'Àáîíåíò íå íàéäåí');
end;

function AddService(customer_id : Integer) : Boolean;
begin
  Result := False;
  try
    qInsert.SQL.Text := 'EXECUTE PROCEDURE add_subscr_service(:C_ID, :sid, :cs, :cDATE, null, 1, null, null)';
    qInsert.Params.ParamByName('C_ID').AsInteger  := customer_id;
    qInsert.Params.ParamByName('sid').AsInteger   := cbServices.KeyValue;
    qInsert.Params.ParamByName('cs').AsInteger    := cbCS.KeyValue;
    qInsert.Params.ParamByName('cDate').AsDate    := dtp1.Date;
    qInsert.ExecSQL;
    qInsert.Transaction.Commit;
    Result := True;
  except
    Result := False;
  end;
end;

procedure mmoAccountsChange(Sender: TObject);
begin
  btnConnect.Enabled := (mmoAccounts.Lines.Count>0);
end;

