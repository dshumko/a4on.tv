var
  v, wb, ws, wh:Variant;
  i : Integer;
  IBQuery1: TIBQuery;
  IBDatabase1: TIBDatabase;
  IBTransaction1: TIBTransaction;

begin
  IBQuery1 := TIBQuery.Create(nil);
  IBDatabase1 := TIBDatabase.Create(nil);
  IBTransaction1 := TIBTransaction.Create(nil);

    with IBDatabase1 do
    begin
        Name := 'IBDatabase1';
        Params.Clear;
        LoginPrompt := False;
        DatabaseName := A4ON_DB;
        Params.Add('user_name='+A4ON_USER);
        Params.Add('password='+A4ON_PASSWORD);
        Params.Add('sql_role_name=ROLE_A4USER');
        Params.Add('lc_ctype=UTF8');
        Connected := False;
        DefaultTransaction := IBTransaction1;
    end;
    with IBTransaction1 do begin
        Name := 'IBTransaction1';
        DefaultDatabase := IBDatabase1;
    end;
    with IBQuery1 do begin
        Name := 'IBQuery1';
        Database := IBDatabase1;
        Transaction := IBTransaction1;
    end;

    IBQuery1.SQL.Text := 'select list(s.Name) NAME' + #13#10 +
       'from subscr_serv ss inner join Services s on (ss.Serv_Id = s.Service_Id)' + #13#10 +
       'where ss.Customer_Id = :cid and ss.State_Sgn = 1';

  try
    CustomersForm.dsCustomers.Disablecontrols;
    CustomersForm.dsCustomers.First;
    v:=CreateOLEObject('Excel.application');
    wb:=v.WorkBooks.Add;
    ws:=wb.WorkSheets;
    wh:=ws.Item('Ëèñò1');
    // Ñîçäàäèì çàãîëîâîê òàáëèöû
    wh.Cells.Item[1, 1].Value:='';
    wh.Cells.Item[1, 2].Value:='Äîãîâîğ';
    wh.Cells.Item[1, 3].Value:='ÔÈÎ';
    wh.Cells.Item[1, 4].Value:='Àäğåñ';
    wh.Cells.Item[1, 5].Value:='Ñòàòóñ';
    wh.Cells.Item[1, 6].Value:='Áàëàíñ';

    i:=2;
    // Ïåğåíåñåì âñåõ àáîíåíòîâ
    while not CustomersForm.dsCustomers.Eof do begin
      wh.Cells.Item[i, 2].Value:=CustomersForm.dsCustomers.FieldByName('DOGOVOR_NO').AsString;
      wh.Cells.Item[i, 3].Value:=CustomersForm.dsCustomers.FieldByName('SURNAME').AsString
                                + ' '+CustomersForm.dsCustomers.FieldByName('FIRSTNAME').AsString
                                + ' '+CustomersForm.dsCustomers.FieldByName('MIDLENAME').AsString;
      wh.Cells.Item[i, 4].Value:=CustomersForm.dsCustomers.FieldByName('STREET_SHORT').AsString
                                + ' '+CustomersForm.dsCustomers.FieldByName('STREET_NAME').AsString
                                + ' ä.'+CustomersForm.dsCustomers.FieldByName('HOUSE_NO').AsString
                                + ' êâ.'+CustomersForm.dsCustomers.FieldByName('FLAT_NO').AsString;

      IBQuery1.Params.ParamByName('cid').AsInteger := CustomersForm.dsCustomers.FieldByName('CUSTOMER_ID').AsInteger;
      IBQuery1.Open;
      wh.Cells.Item[i, 5].Value:=IBQuery1.FieldByName('NAME').AsString;
      IBQuery1.Close;

      wh.Cells.Item[i, 6].Value:=-1*CustomersForm.dsCustomers.FieldByName('DEBT_SUM').AsFloat;



      CustomersForm.dsCustomers.Next;
      i:=i+1;
    end;
    CustomersForm.dsCustomers.EnableControls;
    v.Visible:=True;
  except
    ShowMessage('Îòêğîéòå ñïèñîê àáîíåíòîâ (ÀÁÎÍÅÍÒÛ)!');
  end;

  IBQuery1.Free;
  IBTransaction1.Free;
  IBDatabase1.Free;
end.

var
  f : TForm;
  b : TButton;
  btnEXPORT : TButton;
  Panel1: TPanel;
  DBGrid1: TDBGrid;
  DataSource1: TDataSource;
  qryCustomers: TIBQuery;
  IBDatabase1: TIBDatabase;
  IBTransaction1: TIBTransaction;
  SaveDialog : TSaveDialog;
  list : TStrings;

procedure ButtonClick(Sender: TButton);
begin
  f.ModalResult := mrOk;
end;

procedure ExportClick(Sender: TButton);
var
 s : String;
begin
  if SaveDialog.Execute then begin
    qryCustomers.First;
    qryCustomers.DisableControls;
    List.Clear;
    // "Íîìåğ ëèöåâîãî ñ÷¸òà;Ïîëíûé àäğåñ;Òàğèô;"
    while not qryCustomers.EOF do begin
      s:= qryCustomers.FieldByName('ACCOUNT_NO').AsString+';';
      s:= s+qryCustomers.FieldByName('street_short').AsString+' '
           +qryCustomers.FieldByName('Street_Name').AsString+','
           +qryCustomers.FieldByName('House_No').AsString+','
           +qryCustomers.FieldByName('FLAT_NO').AsString+';';
      s:= s+FloatToStr(qryCustomers.FieldByName('FOR_PAY').AsFloat);
      List.Add(s);
      qryCustomers.Next;
    end;
    qryCustomers.First;
    qryCustomers.EnableControls;
    List.SaveToFile(SaveDialog.FileName);
    f.ModalResult := mrOk;
  end;
end;

begin
  f := TForm.Create(nil);
  f.Caption := 'Ïğèìåğ ìîäóëÿ ıêñïîğòà';
  f.BorderStyle := bsSizeable;
  f.Position := poScreenCenter;
  f.Height := 480;
  f.Width  := 640;

  Panel1 := TPanel.Create(f);
  DBGrid1 := TDBGrid.Create(f);
  DataSource1 := TDataSource.Create(f);
  qryCustomers := TIBQuery.Create(f);
  IBDatabase1 := TIBDatabase.Create(f);
  IBTransaction1 := TIBTransaction.Create(f);
  b := TButton.Create(Panel1);
  btnEXPORT := TButton.Create(Panel1);
  SaveDialog := TSaveDialog.Create(f);
  list := TStringList.Create;
  with Panel1 do
  begin
    Name := 'Panel1';
    Caption := 'Ñïèñîê âñåõ àáîíåíòîâ';
    Parent := f;
    Left := 0;
    Top := 0;
    Width := 562;
    Height := 41;
    Align := alTop;
    BevelOuter := bvNone;
    TabOrder := 0;
  end;
  with btnExport do
  begin
    Name := 'btnExport';
    Parent := Panel1;
    Left := 10;
    Top := 7;
    Width := 150;
    Height := 25;
    TabOrder := 0;
    Caption := 'Ñîõğàíèòü ñïèñîê â ôàéë';
    OnClick := @ExportClick;
    modalResult:= mrNone;
  end;
  with B do
  begin
    Name := 'Button1';
    Parent := Panel1;
    Left := 450;
    Top := 7;
    Width := 75;
    Height := 25;
    TabOrder := 3;
    Caption := 'Çàêğûòü';
    OnClick := @ButtonClick;
  end;
  with DBGrid1 do
  begin
    Name := 'DBGrid1';
    Parent := f;
    Left := 0;
    Top := 41;
    Width := 562;
    Height := 260;
    Align := alClient;
    DataSource := DataSource1;
    TabOrder := 1;
  end;
  with DataSource1 do
  begin
    Name := 'DataSource1';
    DataSet := qryCustomers;
  end;
  with qryCustomers do
  begin
    Name := 'qryCustomers';
    Database := IBDatabase1;
    Transaction := IBTransaction1;
    SQL.Add('select                                                                                            ');
    SQL.Add('    C.Account_No, s.street_short, S.Street_Name, c.Flat_No, H.House_No,                           ');
    SQL.Add('    coalesce((select                                                                              ');
    SQL.Add('      sum(iif(pt.Tarif_Sum is null, t.Tarif_Sum * coalesce(k.Factor_Value, 1), pt.Tarif_Sum))     ');
    SQL.Add('    from Subscr_hist sh                                                                           ');
    SQL.Add('         left outer join Tarif t on (t.Service_Id = sh.Serv_Id and                                ');
    SQL.Add('               current_date between t.Date_From and t.Date_To)                                    ');
    SQL.Add('         left outer join Personal_Tarif pt on (pt.Service_Id = sh.Serv_Id and                     ');
    SQL.Add('               pt.Customer_Id = sh.Customer_Id and                                                ');
    SQL.Add('               current_date between pt.Date_From and pt.Date_To)                                  ');
    SQL.Add('         left outer join Discount_Factor k on (((k.Serv_Id = sh.Serv_Id) or (k.Serv_Id = -1)) and ');
    SQL.Add('               k.Customer_Id = sh.Customer_Id and                                                 ');
    SQL.Add('               current_date between k.Date_From and k.Date_To)                                    ');
    SQL.Add('    where sh.customer_id = c.customer_id), 0) FOR_PAY                                             ');
    SQL.Add('  from CUSTOMER C                                                                                 ');
    SQL.Add('       inner join HOUSE H on (C.HOUSE_ID = H.HOUSE_ID)                                            ');
    SQL.Add('       inner join STREET S on (H.STREET_ID = S.STREET_ID)                                         ');
    SQL.Add('  order by C.account_no                                                                           ');
  end;
  with IBDatabase1 do
  begin
    Name := 'IBDatabase1';
    LoginPrompt := false;
    DefaultTransaction := IBTransaction1;
    DatabaseName := A4ON_DB;
    Params.Add('user_name='+A4ON_USER);
    Params.Add('password='+A4ON_PASSWORD);
    Params.Add('sql_role_name=ROLE_A4USER');
    Params.Add('lc_ctype=UTF8');
    Connected := True;
  end;
  with IBTransaction1 do
  begin
    Name := 'IBTransaction1';
    DefaultDatabase := IBDatabase1;
  end;
  with SaveDialog do begin
    Name:= 'SaveDialog';
    FileName := 'export.txt';
    Filter := '*.TXT|*.TXT';
  end;
  qryCustomers.Active := true;

  f.ShowModal;
  f.Free;
end.

 Var
  f: TForm;

  pnlTop: TPanel;
  Label1: TLabel;
  Label2: TLabel;
  lbl1: TLabel;

  dtp1: TDateTimePicker;
  cbPayDoc: TDBLookupComboBox;
  btnUpdate: TButton;
  srcPayDoc: TDataSource;
  trRead: TIBTransaction;
  trWrite: TIBTransaction;
  DB: TIBDatabase;
  qPayDos: TIBQuery;
  qUpdate: TIBQuery;

procedure btnUpdateClick(Sender: TButton);
var
  hError : boolean;
  i: Integer;
  d : Date;
begin
  hError:= False;
  try
    i := cbPayDoc.KeyValue;
  except
    hError := True;
  end;

  try
    d := dtp1.Date;
  except
    hError := True;
  end;

  if not hError then begin
    if UpdatePayment() then
    begin
      ShowMessage('Äàòû çàìåíåíû');
      f.ModalResult := mrOk;
    end
    else begin
      ShowMessage('Îøèáêà ñìåíû äàòû');
    end
  end
  else
    ShowMessage('Óêàæèòå ÏÄ è äàòó');
end;

function UpdatePayment():boolean;
begin
  Result := false;
  try
    qUpdate.SQL.Text := 'update payment p set p.Pay_Date = :dt where p.Pay_Doc_Id = :pd';
    qUpdate.Params.ParamByName('pd').AsInteger := cbPayDoc.KeyValue;
    qUpdate.Params.ParamByName('dt').AsDate    := dtp1.Date;
    qUpdate.ExecSQL;
    qUpdate.Transaction.Commit;

    qUpdate.SQL.Text := 'update Pay_Doc d set d.Pay_Doc_Date = :dt where d.Pay_Doc_Id = :pd';
    qUpdate.Params.ParamByName('pd').AsInteger := cbPayDoc.KeyValue;
    qUpdate.Params.ParamByName('dt').AsDate    := dtp1.Date;
    qUpdate.ExecSQL;
    qUpdate.Transaction.Commit;

    Result := True;
  except
    Result := False;
  end;
end;

begin
  f := TForm.Create(nil);
  f.Caption := 'Çàìåíà äàòû ÏÄ';
  f.BorderStyle := bsSizeable;
  f.Position := poScreenCenter;
  f.Height := 200;
  f.Width  := 500;

  pnlTop := TPanel.Create(f);
  Label1 := TLabel.Create(f);
  Label2 := TLabel.Create(f);
  lbl1 := TLabel.Create(f);
  dtp1 := TDateTimePicker.Create(f);
  cbPayDoc := TDBLookupComboBox.Create(f);
  btnUpdate := TButton.Create(f);
  srcPayDoc := TDataSource.Create(f);
  trRead := TIBTransaction.Create(f);
  DB := TIBDatabase.Create(f);
  qPayDos := TIBQuery.Create(f);

  qUpdate := TIBQuery.Create(f);
  trWrite := TIBTransaction.Create(f);

  with pnlTop do begin
    Name := 'pnlTop';
    Parent := f;
    Left := 0;
    Top := 0;
    Width := 635;
    Height := 153;
    Align := alTop;
    BevelOuter := bvNone;
    TabOrder := 0;
  end;

  with Label1 do begin
    Name := 'Label1';
    Parent := pnlTop;
    Left := 9;
    Top := 11;
    Width := 71;
    Height := 13;
    Caption := 'Êàêîé ÏÄ';
  end;

  with lbl1 do begin
    Name := 'lbl1';
    Parent := pnlTop;
    Left := 9;
    Top := 63;
    Width := 65;
    Height := 13;
    Caption := 'Íà äàòó';
  end;

  with cbPayDoc do begin
    Name := 'cbPayDoc';
    Parent := pnlTop;
    Left := 88;
    Top := 8;
    Width := 381;
    Height := 21;
    KeyField := 'Pay_Doc_Id';
    ListField := 'NAME';
    ListSource := srcPayDoc;
    TabOrder := 1;
  end;

  with dtp1 do begin
    Name := 'dtp1';
    Parent := pnlTop;
    Left := 88;
    Top := 62;
    Width := 181;
    Height := 21;
    TabOrder := 2;
  end;

  with btnUpdate do begin
    Name := 'btnUpdate';
    Parent := pnlTop;
    Left := 9;
    Top := 122;
    Width := 460;
    Height := 25;
    Caption := 'Ïîìåíÿòü äàòó';
    TabOrder := 3;
    OnClick := @btnUpdateClick;
  end;

  with srcPayDoc do begin
    Name := 'srcPayDoc';
    DataSet := qPayDos;
  end;

  with DB do begin
    Name := 'DB';
    LoginPrompt := False;
    ServerType := 'IBServer';
    DefaultTransaction := trRead;
    LoginPrompt := false;
    DatabaseName := A4ON_DB;
    Params.Add('user_name='+A4ON_USER);
    Params.Add('password='+A4ON_PASSWORD);
    Params.Add('sql_role_name=ROLE_A4USER');
    Params.Add('lc_ctype=UTF8');
    Connected := True;
  end;

  with trRead do begin
    Name := 'trRead';
    DefaultDatabase := DB;
    Params.Clear;
    Params.Add('read_committed');
    Params.Add('rec_version');
    Params.Add('nowait');
    Params.Add('read');
  end;

  with trWrite do
  begin
    Name := 'trWrite';
    DefaultDatabase := db;
    Params.Clear;
    Params.Add('read_committed');
    Params.Add('rec_version');
    Params.Add('nowait');
    Params.Add('write');
  end;

  with qPayDos do begin
    Name := 'qPayDos';
    Database := DB;
    Transaction := trRead;
    BufferChunks := 1000;
    CachedUpdates := False;
    ParamCheck := True;
    SQL.Clear;
    SQL.Add('select d.Pay_Doc_Id, d.Pay_Doc_No||'' / ''||d.Pay_Doc_Date||'' / ''||s.Paysource_Descr name ');
    SQL.Add(' from Pay_Doc d inner join Paysource s on (d.Paysource_Id = s.Paysource_Id) order by d.Pay_Doc_No, d.Pay_Doc_Date');
    Active := True;
    Last;
    First;
  end;

  with qUpdate do begin
    Name := 'qUpdate';
    Database := DB;
    Transaction := trWrite;
    Active := False;
    BufferChunks := 1000;
    CachedUpdates := False;
    ParamCheck := True;
    SQL.Clear;
  end;

  f.ActiveControl := cbPayDoc;
  f.ShowModal;
  f.Free;

end.


var
  f         : TForm;
  db        : TIBDatabase;
  qUpdate   : TIBQuery;
  trWrite   : TIBTransaction;
  lbl1      : TLabel;
  lbl2      : TLabel;
  lbl3      : TLabel;
  btnChange : TButton;
  edOldAcc  : TEdit;
  edNewAcc  : TEdit;
  edDate    : TDateTimePicker;
  chLan     : TCheckBox;
  chBablo   : TCheckBox;
  chAtr     : TCheckBox;

procedure ChangeClick(Sender: TButton);
var
 m,d,o,n : string;
begin
  o := '''' + edOldAcc.Text + '''';
  n := '''' + edNewAcc.Text + '''';
  d := '''' + FormatDateTime('yyyy-mm-dd', edDate.Date) + '''';

qUpdate.Sql.Add(' execute block                                                                                ');
qUpdate.Sql.Add(' as                                                                                           ');
qUpdate.Sql.Add(' declare variable OLD_ACC  varchar(10);                                                       ');
qUpdate.Sql.Add(' declare variable NEW_ACC  varchar(10);                                                       ');
qUpdate.Sql.Add(' declare variable ODATE    date;                                                              ');
qUpdate.Sql.Add(' declare variable old_Id   integer;                                                           ');
qUpdate.Sql.Add(' declare variable new_Id   integer;                                                           ');
qUpdate.Sql.Add(' declare variable House_Id integer;                                                           ');
qUpdate.Sql.Add(' declare variable SGLSRV   integer;                                                           ');
qUpdate.Sql.Add(' declare variable ONSRV    integer;                                                           ');
qUpdate.Sql.Add(' declare variable dolg     numeric(15,2);                                                     ');
qUpdate.Sql.Add(' begin                                                                                        ');
qUpdate.Sql.Add('   OLD_ACC = ' + o + ';                                                                       ');
qUpdate.Sql.Add('   NEW_ACC = ' + n + ';                                                                       ');
qUpdate.Sql.Add('   ODATE = ' + d + ';                                                                         ');
qUpdate.Sql.Add('   SGLSRV = 11;                                                                               ');
qUpdate.Sql.Add('   ONSRV = 1400071;                                                                           ');
qUpdate.Sql.Add('  if (oDATE is null) then oDATE = current_date;                                               ');
qUpdate.Sql.Add('  select Customer_ID, Debt_Sum from Customer where Account_No = :Old_Acc into :old_Id, :dolg; ');
qUpdate.Sql.Add('  new_ID = gen_id(GEN_CUSTOMER_UID, 1);                                                       ');
qUpdate.Sql.Add('  insert into customer (Account_No, Customer_ID, House_Id, Surname, Firstname, Midlename, Notice, Flat_No, Passport_Number, Passport_Registration, Birthday, Adres_Registr, Personal_N, Contract_Date, Debt_Sum) ');
qUpdate.Sql.Add('  select :New_Acc, :new_ID, House_Id, Surname, Firstname, Midlename, Notice, Flat_No, Passport_Number, Passport_Registration, Birthday, Adres_Registr, Personal_N, Contract_Date, 0 ');
qUpdate.Sql.Add('  from Customer where Customer_ID = :old_Id;                                                                ');
qUpdate.Sql.Add('  update Customer_Contacts set Customer_Id = :new_ID where Customer_Id = :old_ID;                           ');
qUpdate.Sql.Add('  for select s.Service_Id from Subscr_Hist sh inner join services s on (sh.Serv_Id = s.Service_Id)          ');
qUpdate.Sql.Add('      where :oDATE between sh.Date_From and sh.Date_To and sh.Customer_Id = :old_Id and s.Business_Type = 1 ');
qUpdate.Sql.Add('      into :House_Id                                                                                        ');
qUpdate.Sql.Add('  do begin                                                                                                  ');
qUpdate.Sql.Add('     execute procedure Add_Subscr_Service(:new_Id, :House_Id, :onsrv, :oDATE, null, 1, null, null);         ');
qUpdate.Sql.Add('     execute procedure Onoff_Service_By_Id(:old_Id, :House_Id, :onsrv, :oDATE, 1, null, 1);                 ');
qUpdate.Sql.Add('  end                                                                                                       ');
qUpdate.Sql.Add('  execute procedure Customer_Services_State(:OLD_Id);                                                       ');
qUpdate.Sql.Add('  execute procedure Customer_Services_State(:new_id);                                                       ');

if chLan.Checked then begin
qUpdate.Sql.Add('  update Billing set Customer_Id = :new_Id, login = :New_Acc where Customer_Id = :old_Id;                   ');
qUpdate.Sql.Add('  update Tv_Lan  set Customer_Id = :new_Id  where Customer_Id = :OLD_Id;                                    ');
end;

if chAtr.Checked then begin
qUpdate.Sql.Add('  update Customer_Attributes set Customer_Id = :new_Id where Customer_Id = :OLD_Id;                         ');
end;

if chBablo.Checked then begin
qUpdate.Sql.Add('  if (dolg <> 0) then begin                                                                                 ');
qUpdate.Sql.Add('    execute procedure Add_Single_Service(:new_Id, :sglsrv, :dolg, :oDATE, ''money transfer'', null);        ');
qUpdate.Sql.Add('    execute procedure Add_Single_Service(:old_Id, :sglsrv, :dolg * (-1), :oDATE, ''money transfer'', null); ');
qUpdate.Sql.Add('  end                                                                                                       ');
end;

qUpdate.Sql.Add('end                                                                                                         ');

  //qUpdate.Params.Clear;
  qUpdate.Transaction.StartTransaction;
  qUpdate.ExecSQL;
  qUpdate.Transaction.Commit;
  f.ModalResult := mrOk;
end;

begin
  f := TForm.Create(nil);
  f.Caption := 'Ğàññ÷åò ïğåîïëàòû';
  f.BorderStyle := bsDialog;
