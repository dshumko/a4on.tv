procedure CreateClick(Sender: TButton);
var
  s,sh : string;
  i : Integer;
begin
  mmoRes.Lines.Clear;
  for i:=0 to (mmo.Lines.Count-1) do begin
    dsList.Close;
    dsList.SQL.Text := 'SELECT C.ACCOUNT_NO FROM CUSTOMER C WHERE C.ACCOUNT_NO = '''+mmo.Lines.Strings[i]+'''';
    dsList.Open;
    if dsList.RecordCount = 0 then mmoRes.Lines.Add(mmo.Lines.Strings[i]);
  end;
  if mmoRes.Lines.Count > 0
  then begin
    mmoRes.Lines.Insert(0,'Ñïèñîê ëèöåâûõ îòñóòñòâóşùèõ â ÁÄ ');
    btnSave.Enabled := true;
  end
  else mmoRes.Lines.Add('Âñå ëèöåâûå èç ñïèñêà ïğèñóòñòâóşò â ÁÄ ');

end;

procedure SaveClick(Sender: TButton);
var
  s : string;
  i : integer;
begin
  if SaveDialog.Execute
  then mmoRes.Lines.SaveToFile(SaveDialog.FileName);
end;

