  with qryCustomers do
  begin
    Name := 'qryCustomers';
    Database := IBDatabase1;
    Transaction := IBTransaction1;
    SQL.Add('select C.* ,s.street_short ,S.Street_Name ,H.House_No');
    SQL.Add('FROM CUSTOMER C INNER JOIN HOUSE H ON (C.HOUSE_ID = H.HOUSE_ID) INNER JOIN STREET S ON (H.STREET_ID = S.STREET_ID)');
    SQL.Add('order by CAST(LPAD(C.account_no,10,''0'') as varchar(10))');
  end;
  with IBDatabase1 do
  begin
    Name := 'IBDatabase1';
    LoginPrompt := false;
    DefaultTransaction := IBTransaction1;
