procedure ButtonClick(Sender: TButton);
begin
  f.ModalResult := mrOk;
end;

procedure OpenClick(Sender: TButton);
begin
    qryCustomers.SQL.Clear;
    qryCustomers.SQL.Add('select distinct c.Surname, c.Firstname, c.Midlename, cc.Cc_Value, c.Debt_Sum');
    qryCustomers.SQL.Add('from customer c');
    qryCustomers.SQL.Add('inner join Customer_Contacts cc on (cc.Customer_Id = c.Customer_Id)');
    qryCustomers.SQL.Add('inner join Subscr_hist s on (s.Customer_Id = c.Customer_Id)');
    qryCustomers.SQL.Add('where current_date between s.Date_From and s.Date_To and cc.Cc_Type = 1');
    qryCustomers.SQL.Add('and c.Debt_Sum >= ' + edtSUM.Text);
    qryCustomers.Active := true;
end;

procedure ExportClick(Sender: TButton);
var
 s : String;
v, wb, ws, wh:Variant;
i : Integer;
begin
  try

    v:=CreateOLEObject('Excel.application');
    wb:=v.WorkBooks.Add;
    ws:=wb.WorkSheets;
    wh:=ws.Item('Ëèñò1');
    // Ñîçäàäèì çàãîëîâîê òàáëèöû
    wh.Cells.Item[1, 1].Value:='Ôàìèëèÿ';
    wh.Cells.Item[1, 2].Value:='Èìÿ';
    wh.Cells.Item[1, 3].Value:='Îò÷åñòâî';
    wh.Cells.Item[1, 4].Value:='Òåëåôîí';
    wh.Cells.Item[1, 5].Value:='Äîëã';

  qryCustomers.First;
  qryCustomers.DisableControls;

    i:=2;

  while not qryCustomers.EOF do begin
     wh.Cells.Item[i, 1].Value:=qryCustomers.FieldByName('Surname').AsString;
     wh.Cells.Item[i, 2].Value:=qryCustomers.FieldByName('Firstname').AsString;
     wh.Cells.Item[i, 3].Value:=qryCustomers.FieldByName('Midlename').AsString;
     wh.Cells.Item[i, 4].Value:=qryCustomers.FieldByName('Cc_Value').AsString;
     wh.Cells.Item[i, 5].Value:=qryCustomers.FieldByName('Debt_Sum').AsString;
     i:=i+1;
    qryCustomers.Next;
  end;

  v.Visible:=True;
  qryCustomers.EnableControls;

  except
    ShowMessage('Îòêğîéòå ñïèñîê àáîíåíòîâ (ÀÁÎÍÅÍÒÛ)!');
  end;
end;

